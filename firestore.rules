rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isIncomingOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User preferences
    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Visions
    match /visions/{visionId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Goals
    match /goals/{goalId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Milestones
    match /milestones/{milestoneId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Projects
    match /projects/{projectId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Habits
    match /habits/{habitId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Habit entries
    match /habitEntries/{entryId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Daily plans
    match /dailyPlans/{planId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Time blocks
    match /timeBlocks/{blockId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Focus sessions
    match /focusSessions/{sessionId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Journal entries
    match /journalEntries/{entryId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // Weekly reviews
    match /weeklyReviews/{reviewId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }

    // AI conversations
    match /aiConversations/{conversationId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingOwner();
      allow update: if isResourceOwner() && isIncomingOwner();
    }
  }
}

